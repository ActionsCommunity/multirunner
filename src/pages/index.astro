---
import AgentPluginSection from "../components/AgentPluginSection.astro";
import ScaleSetSection from "../components/ScaleSetSection.astro";
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;
const repoUrl = "https://github.com/actionscommunity/multirunner";
const configExample = `github:
  scope: repo
  owner: my-user
  repo: my-repo
auth:
  pat: "\${GITHUB_PAT}"
pools:
  - name: linux
    os: linux
    size: 3
    labels: [self-hosted, linux, x64]
    docker:
      host: "tcp://127.0.0.1:2375"`;
---

<Layout
  title="multirunner | Run GitHub Actions on your own hardware"
  description="Run fresh Linux and Windows GitHub Actions self-hosted runners in parallel on one machine."
>
  <section class="hero page-shell">
    <div class="hero-copy">
      <p class="eyebrow">GitHub Actions</p>
      <h1>Run GitHub Actions on your own hardware.</h1>
      <p class="lead">
        Run Linux and Windows jobs in parallel on hardware you control. Each job
        gets a fresh container or VM. When it finishes, multirunner throws it away
        and starts another.
      </p>
      <div class="actions">
        <a class="button" href={`${repoUrl}#build-from-source`}>Build from source</a>
        <a class="button secondary" href={`${base}commands/`}>Read the CLI reference</a>
      </div>
      <div class="platforms" aria-label="Supported platforms">
        <span>Linux</span>
        <span>Windows</span>
        <span>macOS service host</span>
        <span>x64</span>
        <span>ARM64</span>
        <span>Actions scale sets</span>
      </div>
    </div>
    <div class="hero-art">
      <img
        src={`${base}images/hero-terminal.svg`}
        alt="Placeholder for a multirunner terminal demonstration"
        width="1280"
        height="720"
        fetchpriority="high"
      />
      <div class="terminal-sample" aria-label="Example multirunner commands">
        <code class="shell">multirunner doctor --config config.yaml</code>
        <code class="shell">multirunner run --config config.yaml</code>
      </div>
    </div>
  </section>

  <section class="section" id="features">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Built for the job queue</p>
          <h2>Fast between jobs. Clean for every job.</h2>
        </div>
        <p>
          A standard self-hosted runner processes one job at a time. multirunner
          keeps a configurable pool ready, assigns each runner one job, and replaces
          it with a clean environment when the job exits.
        </p>
      </div>
      <div class="feature-list">
        <article class="feature">
          <span class="feature-number">01</span>
          <h3>Real parallelism</h3>
          <p>Run multiple isolated runner registrations on one host instead of maintaining each runner by hand.</p>
        </article>
        <article class="feature">
          <span class="feature-number">02</span>
          <h3>Ephemeral by default</h3>
          <p>Each runner takes one job, deregisters, and gives way to a fresh container or VM.</p>
        </article>
        <article class="feature">
          <span class="feature-number">03</span>
          <h3>Local caches</h3>
          <p>Keep Actions cache traffic and git history on the host to avoid downloading the same data for every job.</p>
        </article>
        <article class="feature">
          <span class="feature-number">04</span>
          <h3>Linux and Windows</h3>
          <p>Use Docker or Podman for Linux, containerd with runhcs for Windows containers, or QEMU for Windows VMs.</p>
        </article>
        <article class="feature">
          <span class="feature-number">05</span>
          <h3>Pool, autoscale, or scale set</h3>
          <p>Keep runners warm, react to queued work, or let GitHub report desired capacity through Actions runner scale sets.</p>
        </article>
        <article class="feature">
          <span class="feature-number">06</span>
          <h3>Host-native service</h3>
          <p>Install the orchestrator with Windows SCM, Linux systemd, or macOS launchd, with health and Prometheus endpoints.</p>
        </article>
      </div>
    </div>
  </section>

  <ScaleSetSection />

  <section class="section">
    <div class="page-shell split">
      <div>
        <p class="eyebrow">Quick start</p>
        <h2>From config to a three-runner pool.</h2>
        <p class="lead">
          Install from source, create a repository-scoped configuration, then start
          the pool. The runner image is pulled automatically.
        </p>
        <a class="text-link" href={`${repoUrl}/blob/main/config.example.yaml`}>
          Explore every configuration option
        </a>
      </div>
      <div class="code-stack">
        <div>
          <p class="code-label">Build current main</p>
          <pre><code>git clone https://github.com/ActionsCommunity/multirunner.git
cd multirunner
go build ./cmd/multirunner</code></pre>
        </div>
        <div>
          <p class="code-label">config.yaml</p>
          <pre><code>{configExample}</code></pre>
        </div>
        <div>
          <p class="code-label">Run</p>
          <pre><code>export GITHUB_PAT=...
multirunner run --config config.yaml --dry-run
multirunner run --config config.yaml</code></pre>
        </div>
      </div>
    </div>
  </section>

  <AgentPluginSection />

  <section class="section">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Execution backends</p>
          <h2>Pick the isolation your jobs need.</h2>
        </div>
        <p>
          Pools can target separate backends and labels from one configuration.
          Route each workflow job with the same familiar <code>runs-on</code> labels.
        </p>
      </div>
      <div class="backend-grid">
        <article>
          <p class="backend-kicker">Linux</p>
          <h3>Docker or Podman</h3>
          <p>Use the docker-compatible API with prebuilt minimal, native-build, Node, .NET, Rust, and Go image tiers.</p>
        </article>
        <article>
          <p class="backend-kicker">Windows host</p>
          <h3>containerd and runhcs</h3>
          <p>Run native Windows containers through the Host Compute Service without requiring Docker Desktop.</p>
        </article>
        <article>
          <p class="backend-kicker">Linux, Windows, macOS</p>
          <h3>QEMU Windows VMs</h3>
          <p>Use KVM on Linux, WHPX on Windows, HVF on Intel Macs, or slower TCG emulation on ARM hosts.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page-shell final-cta">
      <p class="eyebrow">Start with one binary</p>
      <h2>Make self-hosted runners disposable.</h2>
      <p class="lead">Read the source or build current main with Go.</p>
      <div class="actions">
        <a class="button" href={`${repoUrl}#build-from-source`}>Build from source</a>
        <a class="button secondary" href={repoUrl}>Browse the source</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    min-height: calc(100vh - 64px);
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .hero-copy .lead {
    margin: 1.5rem 0 0;
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2.25rem;
  }

  .platforms span {
    padding: 0.25rem 0.55rem;
    color: var(--dim);
    border: 1px solid var(--line);
    font: 700 0.72rem/1.4 "SFMono-Regular", Consolas, monospace;
    text-transform: uppercase;
  }

  .hero-art {
    position: relative;
  }

  .hero-art img {
    display: block;
    border: 1px solid var(--line);
    box-shadow: 22px 22px 0 rgba(64, 216, 255, 0.08);
  }

  .terminal-sample {
    display: grid;
    gap: 0.5rem;
    width: calc(100% - 2rem);
    margin: -3.5rem auto 0;
    padding: 1rem;
    position: relative;
    color: #d8f6ff;
    background: #030a11;
    border: 1px solid var(--line);
    font-size: clamp(0.68rem, 1.35vw, 0.85rem);
  }

  .split {
    display: grid;
    grid-template-columns: 0.75fr 1.25fr;
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .split .lead {
    margin: 1.5rem 0;
  }

  .split > *,
  .code-stack,
  .code-stack > div {
    min-width: 0;
  }

  .text-link {
    font-weight: 750;
  }

  .code-stack {
    display: grid;
    gap: 1rem;
  }

  .code-label {
    margin: 0 0 0.35rem;
    color: var(--orange);
    font: 700 0.72rem/1.2 "SFMono-Regular", Consolas, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .backend-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .backend-grid article {
    padding-top: 1rem;
    border-top: 3px solid var(--cyan);
  }

  .backend-grid article:nth-child(2) {
    border-color: var(--lime);
  }

  .backend-grid article:nth-child(3) {
    border-color: var(--orange);
  }

  .backend-grid p:last-child {
    color: var(--muted);
  }

  .backend-kicker {
    color: var(--dim);
    font: 700 0.72rem/1.2 "SFMono-Regular", Consolas, monospace;
    text-transform: uppercase;
  }

  .final-cta {
    max-width: 800px;
    margin-left: max(1rem, calc((100vw - var(--max)) / 2));
    margin-right: auto;
  }

  @media (max-width: 860px) {
    .hero,
    .split {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: auto;
    }

    .hero-art {
      max-width: 680px;
    }

    .backend-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
