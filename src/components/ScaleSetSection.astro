---
const scaleSetConfig = `provisioning: scaleset

github:
  scope: repo
  owner: my-org
  repo: my-repo

pools:
  - name: linux-pool
    os: linux
    size: 4
    scale_set: multirunner-linux
    runner_group: Default
    labels: [self-hosted, linux, x64]`;
---

<section class="section scale-set-section" id="scale-sets">
  <div class="page-shell scale-set-layout">
    <div class="scale-set-copy">
      <h2>Let GitHub drive runner capacity.</h2>
      <p class="lead">
        multirunner is built on the
        <a href="https://github.com/actions/scaleset"><code>actions/scaleset</code></a>
        technology. It holds a long-poll session open while GitHub supplies the
        desired runner count and encoded JIT configuration.
      </p>
      <p>
        This is the same scale-set mechanism used by actions-runner-controller,
        delivered as one host process without requiring Kubernetes. Docker,
        Podman, containerd, and QEMU continue through the same execution backends.
      </p>
      <ul class="scale-set-benefits">
        <li><strong>Fast assignments:</strong> receive work in seconds without tuning a poll interval.</li>
        <li><strong>NAT-safe:</strong> keep an outbound long-poll session with no inbound endpoint.</li>
        <li><strong>Real capacity:</strong> tell GitHub when the host is saturated instead of dropping requests.</li>
      </ul>
    </div>
    <div class="scale-set-config">
      <p class="config-label">config.yaml</p>
      <pre><code>{scaleSetConfig}</code></pre>
      <p class="config-note">
        One scale set maps to one target and one label set. Pool <code>size</code>
        is the maximum capacity advertised to GitHub.
      </p>
    </div>
  </div>
</section>

<style>
  .scale-set-section {
    position: relative;
    overflow: hidden;
    color: var(--paper);
    background: var(--cobalt);
  }

  .scale-set-section::after {
    position: absolute;
    right: clamp(1rem, 5vw, 5rem);
    bottom: -26px;
    width: 72px;
    height: 72px;
    background: var(--orange);
    content: "";
  }

  .scale-set-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.88fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .scale-set-copy h2,
  .scale-set-copy code {
    color: var(--paper);
  }

  .scale-set-copy code {
    background: var(--ink);
  }

  .scale-set-copy > p,
  .scale-set-copy .lead {
    color: color-mix(in srgb, var(--paper) 86%, var(--cobalt));
  }

  .scale-set-copy .lead {
    margin: var(--space-4) 0 var(--space-3);
  }

  .scale-set-copy a {
    color: var(--paper);
  }

  .scale-set-benefits {
    display: grid;
    gap: 0;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--paper);
  }

  .scale-set-benefits li {
    padding: 0.8rem 0;
    color: color-mix(in srgb, var(--paper) 86%, var(--cobalt));
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 36%, var(--cobalt));
  }

  .scale-set-benefits strong {
    color: var(--paper);
  }

  .scale-set-config {
    min-width: 0;
  }

  .scale-set-config pre {
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--paper) 50%, var(--cobalt));
  }

  .config-label {
    margin: 0 0 0.45rem;
    color: var(--paper);
    font: 600 0.72rem/1.2 var(--font-mono);
  }

  .config-note {
    margin: var(--space-3) 0 0;
    color: color-mix(in srgb, var(--paper) 80%, var(--cobalt));
    font-size: 0.88rem;
  }

  .config-note code {
    color: var(--paper);
    background: color-mix(in srgb, var(--ink) 24%, transparent);
  }

  @media (max-width: 860px) {
    .scale-set-layout {
      grid-template-columns: 1fr;
    }
  }
</style>
